# ==============================================================================
# Authenova Environment Variables Configuration
# ==============================================================================

# Database
# SQLite (default): sqlite:///./data/authenova.db
# PostgreSQL: postgresql://user:password@localhost:5432/authenova
DATABASE_URL=sqlite:///./data/authenova.db

# ==============================================================================
# LLM & Prompt Engineering Settings for RAG Module
# ==============================================================================
# Provider auto-detection order:
# 1. GROQ_API_KEY (Ultra-fast LPU inference: qwen/qwen3.8-27b, groq/compound-mini, etc.)
# 2. GEMINI_API_KEY / GOOGLE_API_KEY (Google Gemini: gemini-1.5-flash)
# 3. OPENAI_API_KEY / LLM_API_BASE (OpenAI or compatible local endpoint: gpt-4o-mini)
# 4. If none provided, automatically uses Authenova's deterministic prompt synthesizer (Zero API key needed)

# Groq Cloud API (Recommended for ultra-fast response times)
GROQ_API_KEY=
LLM_MODEL_NAME=qwen/qwen3.8-27b

# Google Gemini API
GEMINI_API_KEY=
# or GOOGLE_API_KEY=

# OpenAI or Local / Ollama API
OPENAI_API_KEY=
LLM_API_BASE=
